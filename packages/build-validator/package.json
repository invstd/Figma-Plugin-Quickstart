{
  "name": "@inversestudio/build-validator",
  "version": "1.0.0",
  "description": "AST-based validator that scans built Figma plugin files for design system violations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "figma-validate-build": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
